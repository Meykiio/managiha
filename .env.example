# Managiha environment. Copy this file to `.env` and fill in your own values.
#
#   macOS / Linux / Git Bash:  cp .env.example .env
#   Windows PowerShell:        Copy-Item .env.example .env
#
# `.env` is gitignored. Never commit it.

# Your Supabase project URL. Project Settings -> API.
# On a fresh local-ish project this looks like https://abcdefghijklmn.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (older projects label it "anon"). Also under Settings -> API.
#
# This key is PUBLIC BY DESIGN and safe to ship: the VITE_ prefix means Vite
# inlines it into the JavaScript bundle, where anyone can read it. That is fine
# for this key.
#
# The service_role key is NOT the same thing. It bypasses every row-level security
# policy in the database. It must never appear here, in any VITE_ variable, or
# anywhere in this repository. Use it only from server-side tooling.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Error reporting. Leave empty and Sentry is not initialised at all —
# the in-app error boundary still catches and displays errors either way.
VITE_SENTRY_DSN=
