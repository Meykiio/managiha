{
  "name": "managiha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bundle": "node scripts/build-schema-bundle.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "gate": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gate:e2e": "npm run build -- --mode test && playwright test",
    "knip": "knip --no-progress",
    "dev:host": "vite --host 0.0.0.0 --port 5173",
    "lighthouse": "lhci autorun",
    "gate:all": "npm run lint && npm run typecheck && npm test && npm run gate:e2e && npm run knip",
    "security:semgrep": "semgrep --config=.semgrep.yml --config=p/owasp-top-ten --error src",
    "load:test": "k6 run scripts/load-test.js"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "knip": "^5.45.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "~5.5.4",
    "vite": "^5.4.7",
    "vitest": "^2.1.9"
  }
}
